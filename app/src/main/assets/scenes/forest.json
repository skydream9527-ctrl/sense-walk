{
  "schemaVersion": 2,
  "id": "forest",
  "name": "森林",
  "mood": "树荫、清爽、生命感",
  "themeColor": "#1F2A22",
  "requiredDistanceMeters": 800,
  "stickCurveId": "comfort_v1",
  "phases": [
    { "id": "void", "atMeters": 0, "channel": "visual", "layer": "void", "toOpacity": 1.0 },
    { "id": "steps", "atMeters": 80, "channel": "audio", "layer": "footsteps", "toVolume": 0.25, "fadeMs": 8000 },
    { "id": "tree_outline", "atMeters": 80, "channel": "visual", "layer": "tree_outline", "toOpacity": 0.6, "fadeMeters": 20 },
    { "id": "ambience", "atMeters": 240, "channel": "audio", "layer": "ambience", "toVolume": 0.35, "fadeMs": 12000 },
    { "id": "tree_trunks", "atMeters": 240, "channel": "visual", "layer": "tree_trunks", "toOpacity": 0.7, "fadeMeters": 25 },
    { "id": "haptic_steps", "atMeters": 400, "channel": "haptic", "pattern": "footstep_soft", "everyNSteps": 2 },
    { "id": "leaf_path", "atMeters": 400, "channel": "visual", "layer": "leaf_path", "toOpacity": 0.8, "fadeMeters": 25 },
    { "id": "deep_birds", "atMeters": 600, "channel": "audio", "layer": "deep_birds", "toVolume": 0.2, "fadeMs": 10000 },
    { "id": "light_shows", "atMeters": 600, "channel": "visual", "layer": "light_shows", "toOpacity": 0.65, "fadeMeters": 30 },
    { "id": "clearing", "atMeters": 760, "channel": "visual", "layer": "clearing", "toOpacity": 0.9, "fadeMeters": 25 }
  ],
  "pathProfile": {
    "segments": [
      { "from": 0, "to": 140, "kind": "flat" },
      { "from": 140, "to": 240, "kind": "slope_up", "grade": 0.07 },
      { "from": 240, "to": 270, "kind": "gap_hop" },
      { "from": 270, "to": 400, "kind": "uneven" },
      { "from": 400, "to": 520, "kind": "flat" },
      { "from": 520, "to": 620, "kind": "slope_up", "grade": 0.05 },
      { "from": 620, "to": 720, "kind": "uneven" },
      { "from": 720, "to": 800, "kind": "flat" }
    ]
  },
  "layers": {
    "footsteps": { "type": "stepOneShot", "files": ["audio/forest_step_01.ogg", "audio/forest_step_02.ogg", "audio/forest_step_03.ogg", "audio/forest_step_04.ogg", "audio/forest_step_05.ogg", "audio/forest_step_06.ogg"] },
    "ambience": { "type": "loop", "file": "audio/forest_insects.ogg" },
    "deep_birds": { "type": "loop", "file": "audio/forest_birds.ogg" }
  },
  "visualLayers": {
    "void": { "type": "solid", "color": "#060806" },
    "tree_outline": { "type": "parallax", "asset": "visual/forest_tree_outline.webp", "parallax": 0.3 },
    "tree_trunks": { "type": "parallax", "asset": "visual/forest_tree_trunks.webp", "parallax": 0.3 },
    "leaf_path": { "type": "parallax", "asset": "visual/forest_leaf_path.webp", "parallax": 0.6 },
    "light_shows": { "type": "overlay" },
    "clearing": { "type": "overlay" }
  }
}
